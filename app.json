{
  "expo": {
    "name": "Tidar Scan",
    "slug": "tidar-scan",
    "scheme": "tidarscan",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080C",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ma.tidar.scan"
    },
    "android": {
      "package": "ma.tidar.scan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07080C"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#07080C"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tidar Scan utilise la caméra pour lire les QR codes des billets à l'entrée."
        }
      ]
    ]
  }
}
